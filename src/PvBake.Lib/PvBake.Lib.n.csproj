<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>PvBake.Lib</RootNamespace>
    <AssemblyName>PvBake.Lib</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IniParser.dll">
      <HintPath>..\deps\net40\IniParser.dll</HintPath>
    </Reference>
    <Reference Include="ByteSizeLib.dll">
      <HintPath>..\deps\net40\ByteSizeLib.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Reference Include="Newtonsoft.Json.dll">
      <HintPath>..\deps\net40\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Newtonsoft.Json.dll">
      <HintPath>..\deps\net10.0\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.8" />
  </ItemGroup>

</Project>
