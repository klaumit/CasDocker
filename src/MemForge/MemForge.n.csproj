<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net40;net10.0-windows</TargetFrameworks>
    <NoWarn>WFDEV006;CA1416</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MemForge</RootNamespace>
    <AssemblyName>MemForge</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>False</Deterministic>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.ico" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevForge.UI\DevForge.UI.n.csproj" />
    <ProjectReference Include="..\MemForge.Lib\MemForge.Lib.n.csproj" />
    <Reference Include="Vanara.PInvoke.Shared">
      <HintPath>..\deps\fx40\Vanara.PInvoke.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
