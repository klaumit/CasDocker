<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;net10.0</TargetFrameworks>
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>DevForge.Lib</RootNamespace>
    <AssemblyName>DevForge.Lib</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Reference Include="Newtonsoft.Json.dll">
      <HintPath>..\deps\net40\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="ByteSizeLib.dll">
      <HintPath>..\deps\net40\ByteSizeLib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
